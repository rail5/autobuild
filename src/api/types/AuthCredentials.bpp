@include_once "UsernamePasswordPair.bpp"
@include_once "SessionToken.bpp"

@class AuthCredentials : JsonObject {
	@public @method setValue @JsonObject* value {
		if [[ @dynamic_cast<SessionToken> @value == @nullptr && @dynamic_cast<UsernamePasswordPair> @value == @nullptr ]]; then
			return 1
		fi
		@this.value="@value"
	}

	@public @method getValue {
		# Simply echo the pointer
		echo @this.value
	}

	@public @method serialize {
		@JsonObject* obj="@this.value"
		@obj.serialize
	}

	@public @method deserialize rawJson {
		# First, try to deserialize as SessionToken
		@SessionToken* token=@new SessionToken
		if @token.deserialize "$rawJson"; then
			@this.value="@token"
			return 0
		fi
		@delete @token # Clean up if deserialization failed
		# Next, try to deserialize as UsernamePasswordPair
		@UsernamePasswordPair* pair=@new UsernamePasswordPair
		if @pair.deserialize "$rawJson"; then
			@this.value="@pair"
			return 0
		fi
		@delete @pair # Clean up if deserialization failed
		# If neither worked, return error
		return 1
	}
}

#@AuthCredentials authCreds
#@AuthCredentials authCreds2
#
#@UsernamePasswordPair creds
#@creds.setUsername "user1"
#@creds.setPassword "pass123"
#
#
#@authCreds.setValue &@creds
#@authCreds.serialize
#
#@authCreds2.deserialize "@authCreds.serialize" || echo "Problem"
#
#@authCreds2.serialize
#
#@SessionToken tokenCreds
#@tokenCreds.setSessionToken "abcdef123456"
#
#
#@authCreds.setValue &@tokenCreds
#@authCreds.serialize
#
#@authCreds2.deserialize "@authCreds.serialize" || echo "Problem"
#@authCreds2.serialize
