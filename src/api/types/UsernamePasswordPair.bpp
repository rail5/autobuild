@include_once "../json.bpp"

@class UsernamePasswordPair : JsonObject {
	@public @method setUsername username {
		@this.setPrimitive "username" "\"$username\""
	}

	@public @method setPassword password {
		@this.setPrimitive "password" "\"$password\""
	}

	@public @method getUsername {
		@this.getRaw "username"
	}

	@public @method getPassword {
		@this.getRaw "password"
	}

	@public @method deserialize rawJson {
		# Verify that the JSON contains both "username" and "password" keys,
		# And does NOT contain any extra keys.
		local keys="@(jq -r 'keys[]' <<< "$rawJson" | sort)"
		if [[ "$keys" != $'password\nusername' ]]; then
			return 1
		fi
		@super.deserialize "$rawJson"
	}
}
